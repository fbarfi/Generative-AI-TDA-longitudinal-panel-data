# syntax=docker/dockerfile:1.4

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

# System Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ninja-build \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libopenblas-dev \
    libeigen3-dev \
    libomp-dev \
    libboost-dev \
    && rm -rf /var/lib/apt/lists/*

# BLAS/LAPACK (optional tweak for OpenBLAS use)
ENV BLAS=/usr/lib/aarch64-linux-gnu/libopenblas.so
ENV LAPACK=/usr/lib/aarch64-linux-gnu/libopenblas.so

# Set working directory
WORKDIR /opt

# Install PyTorch first separately to prevent missing dependency for extensions
RUN pip install --upgrade pip setuptools wheel && \
    pip install torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 torchdata==0.7.1 --index-url https://download.pytorch.org/whl/cpu

# Install PyG and torch-sparse from prebuilt wheels
RUN pip install \
    torch-scatter==2.1.2 \
    torch-cluster==1.6.3 \
    torch-spline-conv==1.2.2 \
    torch-sparse==0.6.18 \
    torch-geometric==2.6.1 \
    -f https://data.pyg.org/whl/torch-2.5.1+cpu.html

# Python ML/DS libraries
RUN pip install \
    captum \
    matplotlib \
    matplotlib-venn \
    networkx \
    numpy \
    pandas \
    pytorch_lightning \
    scipy \
    seaborn \
    scikit-learn \
    tqdm \
    xarray \
    pydantic \
    psutil

# Set working directory for app
WORKDIR /app

# Copy application files
COPY scripts_master /app/scripts_master/
COPY project_data /app/project_data/
COPY project_codes /app/project_codes/

# Default entrypoint
CMD ["python3"]
