# syntax=docker/dockerfile:1.4

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim

# System Dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ninja-build \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libopenblas-dev \
    libeigen3-dev \
    libomp-dev \
    libboost-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /opt


RUN apt-get update && apt-get install -y --no-install-recommends \
    libgraphviz-dev \
    graphviz \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch stack with torchdata==0.7.1 and DGL
RUN pip install --upgrade pip setuptools wheel && \
    pip install torch==2.5.1 torchvision torchaudio torchdata==0.7.1 dgl==1.1.3

# Python ML/DS libraries
RUN pip install \
    matplotlib \
    networkx \
    numpy \
    pandas \
    pytorch_lightning \
    scipy \
    seaborn \
    scikit-learn \
    xarray \
    pydantic \
    pygraphviz \
    psutil


# Set working directory for app
WORKDIR /app

# Copy application files
COPY scripts_master /app/scripts_master/
COPY project_data /app/project_data/
COPY project_codes /app/project_codes/

# Default entrypoint
CMD ["python3"]

